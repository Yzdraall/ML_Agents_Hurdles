# Git LFS: large binary assets
*.onnx      filter=lfs diff=lfs merge=lfs -text
*.onnx.data filter=lfs diff=lfs merge=lfs -text
*.fbx       filter=lfs diff=lfs merge=lfs -text
*.gif       filter=lfs diff=lfs merge=lfs -text
*.png       filter=lfs diff=lfs merge=lfs -text
*.demo      filter=lfs diff=lfs merge=lfs -text

# Unity YAML (Force Text serialization): keep LF line endings.
# For Unity Smart Merge, append `merge=unityyamlmerge` to these lines and
# configure the driver in .git/config (see Unity manual, "Smart merge").
*.unity  text eol=lf
*.prefab text eol=lf
*.asset  text eol=lf
*.mat    text eol=lf
*.meta   text eol=lf
